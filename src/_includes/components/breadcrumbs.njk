{# Debe tener un {% set parent = "blog" %}  #}

<ul class="list-inline">
  <li> <a href="/" aria-label="Ir a la página de inicio"> Home </a> </li>
  <span >→</span>
  {% if parent %}
    <li> <a class="ttc"  href="/{{ parent }}" aria-label="Ir a la sección {{ parent }}"> {{ parent }}</a> </li>
    <span >→</span>
  {% endif %}

  {% if page.fileSlug %}
<li> <a class="ttc" href="{{ page.url }}" aria-label="Página actual: {{ page.fileSlug | replace('/', '') | replace('-', ' ') }}">{{ page.fileSlug | replace('/', '') | replace('-', ' ') }} </a> </li>
  {% endif %}



</ul>